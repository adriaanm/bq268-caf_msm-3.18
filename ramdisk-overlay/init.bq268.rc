# BQ268-specific overrides
# Imported from ramdisk init.rc

on early-init
    # Force ADB on — persist partition may have usb.config=none
    setprop persist.sys.usb.config adb
    setprop ro.adb.secure 0

on boot
    insmod /lib/modules/pronto_wlan.ko

on property:sys.boot_completed=1
    stop vm_bms
    stop qcamerasvr
