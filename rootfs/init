#!/bin/sh
# CAF 3.18 initramfs: android_usb ACM + Alpine on p36 (no switch_root)
# Stays in initramfs as PID 1 — alpine available via chroot /mnt/root

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp

# Enable android_usb ACM
USB=/sys/class/android_usb/android0
if [ -d "$USB" ]; then
    echo 0 > $USB/enable
    echo 1d6b > $USB/idVendor
    echo 0104 > $USB/idProduct
    echo "BQ268" > $USB/iProduct
    echo acm > $USB/functions
    echo 1 > $USB/enable
fi

echo 255 > /sys/class/leds/green/brightness 2>/dev/null

# Mount Alpine rootfs
mkdir -p /mnt/root
mount -t ext4 -o rw /dev/mmcblk0p36 /mnt/root 2>/dev/null
if [ -d /mnt/root/etc ]; then
    echo 0 > /sys/class/leds/red/brightness 2>/dev/null
    # Bind virtual fs for chroot
    mount --bind /proc /mnt/root/proc
    mount --bind /sys /mnt/root/sys
    mount --bind /dev /mnt/root/dev
    mkdir -p /mnt/root/dev/pts
    mount --bind /dev/pts /mnt/root/dev/pts
fi

# Wait for ttyGS0
i=0; while [ ! -e /dev/ttyGS0 ] && [ $i -lt 10 ]; do sleep 1; i=$((i+1)); done

if [ -e /dev/ttyGS0 ]; then
    {
        echo ""
        echo "=== CAF 3.18 — BQ268 ==="
        echo "Alpine rootfs: $(cat /mnt/root/etc/alpine-release 2>/dev/null || echo 'NOT MOUNTED')"
        echo "To enter Alpine: chroot /mnt/root /bin/sh"
        echo ""
    } > /dev/ttyGS0
    export PATH=/bin:/sbin:/usr/bin:/usr/sbin
    setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1' &
fi

while true; do sleep 3600; done
