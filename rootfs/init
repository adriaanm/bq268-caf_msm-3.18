#!/bin/sh
# CAF 3.18 initramfs: set up android_usb ACM then switch_root to Alpine on p36

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev

# Enable android_usb ACM (CAF-specific, must happen before switch_root)
USB=/sys/class/android_usb/android0
if [ -d "$USB" ]; then
    echo 0 > $USB/enable
    echo 1d6b > $USB/idVendor
    echo 0104 > $USB/idProduct
    echo "BQ268" > $USB/iProduct
    echo acm > $USB/functions
    echo 1 > $USB/enable
fi

# Green LED = initramfs reached
echo 255 > /sys/class/leds/green/brightness 2>/dev/null

# Mount real rootfs and switch to it
mkdir -p /mnt/root
mount -t ext4 -o rw /dev/mmcblk0p36 /mnt/root

if [ -x /mnt/root/sbin/init ]; then
    # Move virtual filesystems to new root
    mount --move /proc /mnt/root/proc
    mount --move /sys /mnt/root/sys
    mount --move /dev /mnt/root/dev
    exec switch_root /mnt/root /sbin/init
fi

# Fallback: rootfs mount failed — drop to shell on ttyGS0
echo 0 > /sys/class/leds/green/brightness 2>/dev/null
echo 255 > /sys/class/leds/red/brightness 2>/dev/null

i=0; while [ ! -e /dev/ttyGS0 ] && [ $i -lt 10 ]; do sleep 1; i=$((i+1)); done
if [ -e /dev/ttyGS0 ]; then
    echo "ERROR: rootfs mount failed, dropping to shell" > /dev/ttyGS0
    exec setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'
fi
exec sh
