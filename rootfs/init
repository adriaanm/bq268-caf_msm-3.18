#!/bin/sh
# Minimal init for CAF 3.18 register dump comparison
# Console: USB ACM serial (/dev/ttyGS0) via android_usb gadget
# acm_transports defaults to "tty" (patched in android.c)

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
mount -t tmpfs tmpfs /tmp

hostname bq268-caf

# LED indicator: green on = init reached
echo 255 > /sys/class/leds/green/brightness 2>/dev/null

# Enable android_usb with ACM function
# acm_transports is pre-set to "tty" in kernel, just enable
USB=/sys/class/android_usb/android0
if [ -d "$USB" ]; then
    echo 0 > $USB/enable
    echo 1d6b > $USB/idVendor
    echo 0104 > $USB/idProduct
    echo "BQ268" > $USB/iProduct
    echo acm > $USB/functions
    echo 1 > $USB/enable
fi

# Wait for ttyGS0
i=0
while [ ! -e /dev/ttyGS0 ] && [ $i -lt 10 ]; do
    sleep 1
    i=$((i + 1))
done

# Spawn shell on USB serial gadget
if [ -e /dev/ttyGS0 ]; then
    echo 0 > /sys/class/leds/red/brightness 2>/dev/null
    {
        echo ""
        echo "========================================"
        echo " CAF 3.18 minimal Linux — BQ268"
        echo " $(uname -r) / $(uname -m)"
        echo " Register dump: dump-registers"
        echo "========================================"
        echo ""
    } > /dev/ttyGS0
    export ENV=/etc/profile
    setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1' &
else
    # Blink green = ttyGS0 failed
    while true; do
        echo 0 > /sys/class/leds/green/brightness 2>/dev/null; sleep 1
        echo 255 > /sys/class/leds/green/brightness 2>/dev/null; sleep 1
    done
fi

# Spawn shell on UART (fallback)
if [ -e /dev/ttyHSL0 ]; then
    setsid sh -c 'exec sh -l </dev/ttyHSL0 >/dev/ttyHSL0 2>&1' &
fi

# Keep init alive
while true; do
    sleep 3600
done
